{
  "name": "qrcode.react",
  "version": "4.2.0",
  "description": "React component to generate QR codes",
  "keywords": [
    "react",
    "react-component",
    "qrcode"
  ],
  "homepage": "http://zpao.github.io/qrcode.react",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:code && pnpm run build:examples",
    "build:code": "tsdown --filter lib",
    "build:examples": "tsdown --filter examples",
    "build:examples:dev": "tsdown --filter examples --no-minify --env.NODE_ENV=development",
    "lint": "oxlint && oxfmt --check",
    "pretty": "oxfmt",
    "prepack": "make clean && make all && pnpm run typecheck",
    "prepublish-docs": "make clean && make all",
    "publish-docs": "gh-pages --dist=examples --src='{index.html,iife/demo.js}'",
    "serve:examples": "npx serve examples -l 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check"
  },
  "author": "Paul O’Shannessy <paul@oshannessy.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/zpao/qrcode.react.git"
  },
  "license": "ISC",
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "canvas": "^3.2.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "type": "module"
}
